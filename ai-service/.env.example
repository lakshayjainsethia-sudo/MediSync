# ai-service environment configuration
# Copy this file to .env and fill in values

# Ollama LLM server
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_NUM_CTX=512
OLLAMA_NUM_PREDICT=300
OLLAMA_TEMPERATURE=0.2

# MongoDB (same instance as MediSync Node.js server)
MONGO_URI=mongodb://localhost:27017/medisync

# Node.js API Gateway base URL (for tool data fetching)
# In Docker: use service name. Locally: localhost
NODE_API_BASE=http://localhost:5000/api/v1

# FastAPI service settings
FASTAPI_PORT=8000
FASTAPI_HOST=0.0.0.0

# Conversation history limits
MAX_CONVERSATION_MESSAGES=20
MAX_CONTEXT_CHARS=1800
